{
    "require": {
        "aligny/tailwind-builder": "^1.2",
        "cecil/theme-netlify": "^3.0"
    },
    "config": {
        "process-timeout": 0,
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "cecil/theme-installer": true
        }
    },
    "scripts": {
        "css": "tailwind-builder assets/tailwind.css --minify",
        "css:watch": "tailwind-builder assets/tailwind.css --watch",
        "serve": "php cecil.phar serve",
        "build": [
            "@css",
            "php cecil.phar build --optimize"
        ]
    }
}
