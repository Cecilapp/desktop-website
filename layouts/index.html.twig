    {#- Shows only the download buttons of the visitor's OS (and architecture, when known) ~#}
    <script>
      // demo videos are hidden when motion is reduced: stops them too (no download, no playback)
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('[data-demo-video]').forEach(video => {
          video.pause();
          video.querySelectorAll('source').forEach(source => source.remove());
          video.load();
        });
      }
      (async () => {
        const groups = document.querySelectorAll('[data-downloads]');
        // displays the "show all" toggle of a group, labelled for the `context` (desktop or mobile)
        const showToggle = (group, context, onClick) => {
          const toggle = group.querySelector('[data-downloads-all]');
          toggle.querySelector(`[data-context="${context}"]`).hidden = false;
          toggle.hidden = false;
          toggle.addEventListener('click', () => {
            onClick();
            toggle.hidden = true;
          });
        };
        const platform = (navigator.userAgentData?.platform || navigator.platform || '').toLowerCase();
        // mobile devices (iPadOS reports itself as macOS): offers to share the page link instead of the installers
        if (/android|iphone|ipad|ipod/i.test(navigator.userAgent) || (/^mac/.test(platform) && navigator.maxTouchPoints > 1)) {
          groups.forEach(group => {
            const share = group.querySelector('[data-downloads-share]');
            if (!share) return;
            const buttons = group.querySelector('[data-downloads-buttons]');
            buttons.hidden = true;
            share.hidden = false;
            showToggle(group, 'mobile', () => {
              buttons.hidden = false;
              share.hidden = true;
            });
            const button = share.querySelector('button');
            button.addEventListener('click', async () => {
              const url = location.href.split('#')[0];
              try {
                if (navigator.share) return await navigator.share({title: document.title, url});
                await navigator.clipboard.writeText(url);
                button.querySelector('[data-label]').textContent = button.dataset.copied;
              } catch {} // sharing canceled or clipboard denied
            });
          });
          return;
        }
        const os = /^win/.test(platform) ? 'windows' : /^mac/.test(platform) ? 'macos' : null;
        if (!os) return;
        // architecture is only exposed by Chromium browsers (Safari on Apple Silicon reports Intel)
        let arch = null;
        try {
          const values = await navigator.userAgentData?.getHighEntropyValues(['architecture']);
          arch = {arm: 'arm64', x86: 'x64'}[values?.architecture] ?? null;
        } catch {}
        groups.forEach(group => {
          const links = [...group.querySelectorAll('a[data-os]')];
          let matches = links.filter(a => a.dataset.os === os);
          const archMatches = matches.filter(a => a.dataset.arch === arch || a.dataset.arch === 'universal');
          if (arch && archMatches.length) matches = archMatches;
          if (!matches.length || matches.length === links.length) return;
          links.forEach(a => a.hidden = !matches.includes(a));
          showToggle(group, 'desktop', () => links.forEach(a => a.hidden = false));
        });
      })();
    </script>
  </body>
