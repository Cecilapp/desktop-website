{% set home = site.data.home %}
{# Installers of the latest release, read from the electron-builder update files #}
{% set downloads = [] %}
{% for platform in site.download.platforms %}
  {%- set manifest = asset(site.download.manifests ~ platform.manifest, {ignore_missing: true, minify: false, fingerprint: false}) %}
  {%- if not manifest.missing %}
    {%- set release = manifest.content|yaml_parse %}
    {%- set files = (release.files ?? [])|map(f => f.url)|filter(f => f ends with '.' ~ platform.ext) %}
    {%- if files is empty and release.path is defined %}{% set files = [release.path] %}{% endif %}
    {#- one installer per architecture #}
    {%- for file in files %}
      {%- set arch = null %}
      {%- if files|length > 1 %}
        {%- set arch = platform.default_arch ?? null %}
        {%- for key, label in platform.archs ?? {} %}
          {%- if file matches '/[-_.]' ~ key ~ '[-_.]/i' %}{% set arch = label %}{% endif %}
        {%- endfor %}
      {%- endif %}
      {%- set downloads = downloads|merge([{name: platform.name, arch: arch, url: site.download.url ~ file|url_encode, version: release.version}]) %}
    {%- endfor %}
  {%- endif %}
{% endfor %}
<!DOCTYPE html>
<html lang="{{ site.language }}" class="scroll-smooth">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{- include('partials/metatags.html.twig') ~}}
    <meta name="color-scheme" content="light dark">
    {{- html(asset('styles.css')) ~}}
  </head>
  <body class="bg-white text-slate-700 antialiased dark:bg-navy-950 dark:text-slate-300">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:text-navy-800">{% trans %}Skip to content{% endtrans %}</a>
    {#- Navigation ~#}
    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/85 backdrop-blur dark:border-white/10 dark:bg-navy-950/85">
      <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6">
        <a href="{{ url(page) }}" class="flex items-center gap-2.5 font-semibold text-navy-900 dark:text-white">
          {{- html(asset('images/logo.png'), {width: 32, height: 32, alt: '', class: 'size-8'}, {responsive: 'density'}) ~}}
          {{- site.title ~}}
        </a>
        <ul class="ml-auto hidden items-center gap-6 text-sm font-medium md:flex">
          <li><a href="#features" class="hover:text-navy-900 dark:hover:text-white">{% trans %}Features{% endtrans %}</a></li>
          <li><a href="#pricing" class="hover:text-navy-900 dark:hover:text-white">{% trans %}Pricing{% endtrans %}</a></li>
          <li><a href="#faq" class="hover:text-navy-900 dark:hover:text-white">{% trans %}FAQ{% endtrans %}</a></li>
        </ul>
        <div class="ml-auto flex items-center gap-4 md:ml-0">
          {{- include('partials/languages-switcher.html.twig') ~}}
          <a href="#download" class="rounded-lg bg-navy-800 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-navy-700 dark:bg-gold-300 dark:text-navy-950 dark:hover:bg-gold-200">{% trans %}Download free{% endtrans %}</a>
        </div>
      </nav>
    </header>
    <main id="main">
      {#- Hero ~#}
      <section class="relative overflow-hidden bg-navy-900 text-white">
        <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-40 mx-auto h-144 max-w-4xl rounded-full bg-navy-500/30 blur-3xl"></div>
        <div class="relative mx-auto max-w-6xl px-4 pt-20 text-center sm:px-6 sm:pt-28">
          <p class="mb-8 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-gold-200 ring-1 ring-gold-300/30">
            <span class="size-2 rounded-full bg-gold-300" aria-hidden="true"></span>
            {{- home.hero.beta ~}}
          </p>
          <h1 class="mx-auto max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-6xl">{{ home.hero.title }}</h1>
          <p class="mx-auto mt-6 max-w-2xl text-lg text-navy-100 text-pretty">{{ home.hero.text }}</p>
          <div id="download" class="mt-10">
            {{- include('partials/download-buttons.html.twig') ~}}
          </div>
          <p class="mt-3 text-sm text-navy-200">{{ home.hero.note }}</p>
          <div class="mx-auto mt-16 max-w-5xl translate-y-px">
            {{- include('partials/screenshot.html.twig', {screenshot: home.hero.screenshot, eager: true, class: 'rounded-b-none'}) ~}}
          </div>
        </div>
      </section>
      {#- Intro ~#}
      <section id="features" class="mx-auto max-w-3xl px-4 pt-24 pb-8 text-center sm:px-6">
        <h2 class="text-3xl font-bold tracking-tight text-navy-900 text-balance sm:text-4xl dark:text-white">{{ home.intro.title }}</h2>
        <p class="mt-4 text-lg text-pretty">{{ home.intro.text }}</p>
      </section>
      {#- Features with screenshots ~#}
      <div class="mx-auto max-w-6xl space-y-24 px-4 py-16 sm:px-6">
        {%- for feature in home.features ~%}
        <section class="grid items-center gap-10 lg:grid-cols-5 lg:gap-16">
          <div class="lg:col-span-2 {{ loop.index is even ? 'lg:order-last' }}">
            <h3 class="text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl dark:text-white">{{ feature.title }}</h3>
            <div class="mt-4 text-lg text-pretty [&_code]:rounded [&_code]:bg-navy-50 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-base [&_code]:text-navy-800 dark:[&_code]:bg-white/10 dark:[&_code]:text-gold-200">{{ feature.text|markdown_to_html }}</div>
            <ul class="mt-6 space-y-3">
              {%- for point in feature.points ~%}
              <li class="flex gap-3">
                {{- include('partials/icon.html.twig', {name: 'check', class: 'mt-0.5 size-5 shrink-0 text-navy-500 dark:text-gold-300'}) ~}}
                {{- point ~}}
              </li>
              {%- endfor ~%}
            </ul>
          </div>
          <div class="lg:col-span-3">
            {{- include('partials/screenshot.html.twig', {screenshot: feature.screenshot}) ~}}
          </div>
        </section>
        {%- endfor ~%}
      </div>
      {#- More features ~#}
      <section class="bg-navy-50 py-24 dark:bg-navy-900/60">
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <h2 class="text-center text-3xl font-bold tracking-tight text-navy-900 sm:text-4xl dark:text-white">{{ home.more.title }}</h2>
          <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {%- for item in home.more.items ~%}
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-navy-100 dark:bg-navy-950 dark:ring-white/10">
              <div class="flex size-10 items-center justify-center rounded-lg bg-navy-800 text-gold-300">
                {{- include('partials/icon.html.twig', {name: item.icon, class: 'size-5'}) ~}}
              </div>
              <h3 class="mt-4 font-semibold text-navy-900 dark:text-white">{{ item.title }}</h3>
              <p class="mt-2 text-sm/6">{{ item.text }}</p>
            </div>
            {%- endfor ~%}
          </div>
        </div>
      </section>
      {#- Pricing ~#}
      <section id="pricing" class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-navy-900 text-balance sm:text-4xl dark:text-white">{{ home.pricing.title }}</h2>
          <p class="mt-4 text-lg">{{ home.pricing.text }}</p>
        </div>
        <div class="mx-auto mt-14 grid max-w-4xl gap-8 md:grid-cols-2">
          {%- for plan in home.pricing.plans ~%}
          <div class="flex flex-col rounded-3xl p-8 {{ plan.highlight ?? false ? 'bg-navy-900 text-navy-100 shadow-xl ring-1 ring-navy-900 dark:ring-gold-300/40' : 'bg-white ring-1 ring-slate-200 dark:bg-navy-900/40 dark:ring-white/10' }}">
            <h3 class="text-lg font-semibold {{ plan.highlight ?? false ? 'text-gold-300' : 'text-navy-900 dark:text-white' }}">{{ plan.name }}</h3>
            <p class="mt-2 text-sm">{{ plan.text }}</p>
            <p class="mt-6 flex items-baseline gap-2">
              <span class="text-5xl font-bold tracking-tight {{ plan.highlight ?? false ? 'text-white' : 'text-navy-900 dark:text-white' }}">{{ plan.price }}</span>
              <span class="text-sm">{{ plan.period }}</span>
            </p>
            <ul class="mt-8 flex-1 space-y-3 text-sm">
              {%- for item in plan.features ~%}
              <li class="flex gap-3">
                {{- include('partials/icon.html.twig', {name: 'check', class: 'size-5 shrink-0 ' ~ (plan.highlight ?? false ? 'text-gold-300' : 'text-navy-500 dark:text-gold-300')}) ~}}
                {{- item ~}}
              </li>
              {%- endfor ~%}
            </ul>
            {%- if plan.disabled is defined ~%}
            <span aria-disabled="true" class="mt-8 block cursor-not-allowed rounded-lg px-4 py-3 text-center font-semibold {{ plan.highlight ?? false ? 'bg-white/10 text-navy-300' : 'bg-slate-100 text-slate-400 dark:bg-white/5 dark:text-slate-500' }}">{{ plan.cta }}</span>
            <p class="mt-3 text-center text-sm">{{ plan.disabled }}</p>
            {%- else ~%}
            <a href="#download" class="mt-8 block rounded-lg px-4 py-3 text-center font-semibold {{ plan.highlight ?? false ? 'bg-gold-300 text-navy-950 hover:bg-gold-200' : 'bg-navy-800 text-white hover:bg-navy-700 dark:bg-white/10 dark:hover:bg-white/20' }}">{{ plan.cta }}</a>
            {%- endif ~%}
          </div>
          {%- endfor ~%}
        </div>
      </section>
      {#- FAQ ~#}
      <section id="faq" class="border-t border-slate-200 dark:border-white/10">
        <div class="mx-auto max-w-3xl px-4 py-24 sm:px-6">
          <h2 class="text-center text-3xl font-bold tracking-tight text-navy-900 sm:text-4xl dark:text-white">{{ home.faq.title }}</h2>
          <div class="mt-12 divide-y divide-slate-200 dark:divide-white/10">
            {%- for item in home.faq.items ~%}
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-semibold text-navy-900 dark:text-white">
                {{- item.question ~}}
                {{- include('partials/icon.html.twig', {name: 'plus', class: 'faq-marker size-5 shrink-0 text-navy-400 transition-transform'}) ~}}
              </summary>
              <div class="mt-3 [&_a]:font-medium [&_a]:text-navy-600 [&_a]:underline dark:[&_a]:text-gold-300">{{ item.answer|markdown_to_html }}</div>
            </details>
            {%- endfor ~%}
          </div>
        </div>
      </section>
      {#- Closing CTA ~#}
      <section class="px-4 pb-24 sm:px-6">
        <div class="relative mx-auto max-w-6xl overflow-hidden rounded-3xl bg-navy-900 px-6 py-16 text-center text-white sm:py-20">
          <div aria-hidden="true" class="pointer-events-none absolute -bottom-32 left-1/2 h-72 w-160 -translate-x-1/2 rounded-full bg-gold-300/20 blur-3xl"></div>
          {{- html(asset('images/logo.png'), {width: 64, height: 64, alt: '', class: 'relative mx-auto size-16'}, {responsive: 'density'}) ~}}
          <h2 class="relative mt-6 text-3xl font-bold tracking-tight text-balance sm:text-4xl">{{ home.cta.title }}</h2>
          <p class="relative mx-auto mt-4 max-w-xl text-navy-100">{{ home.cta.text }}</p>
          <div class="relative mt-8">
            {{- include('partials/download-buttons.html.twig') ~}}
          </div>
        </div>
      </section>
    </main>
    {#- Footer ~#}
    <footer class="border-t border-slate-200 dark:border-white/10">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p>© {{ site.time|date('Y') }} <a href="https://ligny.fr" class="hover:text-navy-900 dark:hover:text-white">Arnaud Ligny</a></p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          <li><a href="{{ cecil.url }}" class="hover:text-navy-900 dark:hover:text-white">{% trans %}Cecil{% endtrans %}</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>